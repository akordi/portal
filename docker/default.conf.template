server {
    listen        8080;
    listen   [::]:8080;
    server_name   localhost;
    server_tokens off;

    # Container/orchestrator health probe. Exact match wins over the SPA
    # fallback below; access_log off keeps probe traffic out of the logs.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "healthy\n";
    }

    # Document requests go to the local Node SSR process (see server.mjs +
    # docker/40-start-ssr-server.sh), which server-renders the routes it
    # knows are SSR-safe and passes the plain static shell through
    # unmodified for everything else — so this replaces the old
    # `try_files $uri $uri/ /index.html` SPA fallback rather than sitting
    # alongside it. Static assets below are unaffected; they're matched and
    # served directly by nginx before this block is ever reached.
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        add_header X-XSS-Protection "1; mode=block" always;
        add_header X-Frame-Options "Deny" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Feature-Policy "autoplay 'none';" always;
        add_header Cache-Control "no-store, no-transform, must-revalidate, no-cache, max-age=0, private";
    }

    location ~* \.(?:css|js|png|svg|jpg|jpeg|ico|ttf)$ {
        gzip on;
        gzip_static on;
        gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

        expires max;
        add_header Cache-Control "public, max-age=2592000, immutable";
        root   /usr/share/nginx/html;
        index  index.html;
        try_files $uri $uri/ /index.html;

        add_header X-XSS-Protection "1; mode=block" always;
        add_header X-Frame-Options "Deny" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Feature-Policy "autoplay 'none';" always;
    }

    location /api/v2/admin {
            proxy_pass ${API_V2_ADMIN_URL};
            proxy_ssl_server_name on;
            proxy_set_header    X-Real-IP       $remote_addr;
            proxy_set_header    X-Forwarded-for $remote_addr;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            port_in_redirect off;
            proxy_connect_timeout 30;
    }


    location /api/v2 {
            proxy_pass ${API_V2_URL};
            proxy_ssl_server_name on;
            proxy_set_header    X-Real-IP       $remote_addr;
            proxy_set_header    X-Forwarded-for $remote_addr;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            port_in_redirect off;
            proxy_connect_timeout 30;
    }

    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}
